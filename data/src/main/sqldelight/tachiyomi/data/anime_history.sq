import java.util.Date;

CREATE TABLE anime_history(
    _id INTEGER NOT NULL PRIMARY KEY,
    episode_id INTEGER NOT NULL UNIQUE,
    last_seen INTEGER AS Date,
    time_watch INTEGER NOT NULL,
    FOREIGN KEY(episode_id) REFERENCES episodes (_id)
    ON DELETE CASCADE
);

CREATE INDEX anime_history_episode_id_index ON anime_history(episode_id);

getHistoryByAnimeId:
SELECT
    H._id,
    H.episode_id,
    H.last_seen,
    H.time_watch
FROM anime_history H
JOIN episodes EP
ON H.episode_id = EP._id
WHERE EP.anime_id = :animeId AND EP._id = H.episode_id;

getHistoryByEpisodeUrl:
SELECT
    H._id,
    H.episode_id,
    H.last_seen,
    H.time_watch
FROM anime_history H
JOIN episodes EP
ON H.episode_id = EP._id
WHERE EP.anime_id = :animeId AND EP.url = :episodeUrl AND EP._id = H.episode_id;

resetHistoryByIds:
UPDATE anime_history
SET last_seen = 0
WHERE _id IN :historyIds;

resetHistoryByAnimeIds:
UPDATE anime_history
SET last_seen = 0
WHERE _id IN (
    SELECT H._id
    FROM animes A
    INNER JOIN episodes EP
    ON A._id = EP.anime_id
    INNER JOIN anime_history H
    ON EP._id = H.episode_id
    WHERE A._id IN :animeIds
);

removeAllHistory:
DELETE FROM anime_history;

removeResettedHistory:
DELETE FROM anime_history
WHERE last_seen = 0;

upsert:
INSERT INTO anime_history(episode_id, last_seen, time_watch)
VALUES (:episodeId, :seenAt, :time_watch)
ON CONFLICT(episode_id)
DO UPDATE
SET
    last_seen = :seenAt,
    time_watch = time_watch + :time_watch
WHERE episode_id = :episodeId;

getWatchDuration:
SELECT coalesce(sum(time_watch), 0)
FROM anime_history;
